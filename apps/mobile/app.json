{
  "expo": {
    "name": "Sekundo",
    "slug": "sekundo",
    "scheme": "sekundo",
    "version": "1.0.10",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FCFCFC",
          "dark": {
            "backgroundColor": "#141414"
          }
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "microphonePermission": "Sekundo uses the microphone for voice calls with your bots."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "speechRecognitionPermission": "Sekundo turns your speech into messages during voice calls.",
          "microphonePermission": "Sekundo uses the microphone for voice calls with your bots."
        }
      ],
      "expo-localization",
      "@react-native-vector-icons/ionicons",
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0B0C0E"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sekundo uses your photo library so you can attach images to a bot message.",
          "cameraPermission": "Sekundo uses the camera so you can attach photos to a bot message.",
          "microphonePermission": "Sekundo uses the microphone for voice calls with your bots."
        }
      ],
      "expo-sharing",
      "./plugins/with-worklets-headers",
      "./plugins/with-scene-lifecycle"
    ],
    "ios": {
      "bundleIdentifier": "com.sekundo.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "icon": "../../packages/ui-tokens/assets/Anviq.icon",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Sekundo uses the camera so you can attach photos to a bot message.",
        "NSPhotoLibraryUsageDescription": "Sekundo uses your photo library so you can attach images to a bot message.",
        "NSLocalNetworkUsageDescription": "Sekundo connects to a self-hosted Sekundo server on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.sekundo.app",
      "versionCode": 10,
      "softwareKeyboardLayoutMode": "resize",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundImage": "./assets/icon-background.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "supportsRTL": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
