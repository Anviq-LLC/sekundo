# Install ONLY after the upstream is private and oauth2-proxy is configured.
# ANVIQ_PRIVATE_UPSTREAM: private ingress host:port (reachable only by the edge).
# ANVIQ_AUTH_UPSTREAM: local oauth2-proxy host:port, proxying to the same ingress.
{$ANVIQ_PUBLIC_HOST} {
	# Keep the full path: the token in it is checked by Anviq Agents, not by this matcher.
	@screen path /novnc/session/* //novnc/session/*
	handle @screen {
		header {
			Cache-Control "no-store"
			Referrer-Policy "no-referrer"
		}
		reverse_proxy {$ANVIQ_PRIVATE_UPSTREAM} {
			header_up -X-Access-Key
		}
	}
	# Optional native clients: a separate 32-byte hex key, never the origin key.
	# Fail closed when the environment value is absent or malformed.
	@native {
		path /api/* /rpc/*
		header X-Access-Key "{$ANVIQ_NATIVE_ACCESS_KEY}"
		expression `"{$ANVIQ_NATIVE_ACCESS_KEY}".matches("^[a-f0-9]{64}$")`
	}
	handle @native {
		header Cache-Control "no-store"
		reverse_proxy {$ANVIQ_PRIVATE_UPSTREAM} {
			header_up -X-Access-Key
		}
	}
	# Includes /oauth2/callback, all normal pages, /api/* and /novnc/.
	handle {
		reverse_proxy {$ANVIQ_AUTH_UPSTREAM} {
			header_up -X-Access-Key
		}
	}
}
