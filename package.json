{
  "name": "anviq",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE-ANVIQ.md",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^22.22.2 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "gallery": "pnpm --filter @anviq/web dev --open /e2e/fixtures/gallery.html",
    "build": "turbo build",
    "check": "turbo check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @anviq/db generate",
    "db:migrate": "pnpm --filter @anviq/api db:migrate",
    "sandbox:build": "docker build -t anviq/computer:local infra/sandboxes/computer",
    "sandbox:boat-snapshot": "tsx packages/adapters/src/cli/build-boat-snapshot.ts",
    "sandbox:e2b-template": "tsx packages/adapters/src/cli/build-e2b-template.ts",
    "test": "vitest run",
    "test:compose-smoke": "bash infra/compose/run-smokes.sh",
    "test:integration": "tsx packages/testkit/src/cli/harness.ts --integration",
    "test:e2e": "tsx packages/testkit/src/cli/harness.ts --e2e",
    "test:mobile-screenshots": "pnpm --filter @anviq/db generate && tsx packages/testkit/src/cli/mobile-screenshots.ts",
    "ios:screenshots": "pnpm --filter @anviq/db generate && tsx packages/testkit/src/cli/ios-app-screenshots.ts",
    "test:topology": "tsx packages/testkit/src/cli/topology.ts",
    "test:canary": "tsx packages/testkit/src/cli/canary.ts",
    "test:pi": "vitest run packages/testkit/src/model-emulator.test.ts packages/testkit/src/pi-offline.test.ts",
    "test:evals": "tsx packages/testkit/src/cli/evals.ts",
    "test:computer-replay": "tsx packages/testkit/src/cli/computer-replay.ts",
    "test:computer": "tsx packages/testkit/src/cli/computer.ts",
    "test:flows": "tsx packages/testkit/src/cli/flows.ts",
    "perf:desktop": "tsx packages/testkit/src/cli/desktop-performance.ts",
    "perf:compare": "tsx packages/testkit/src/cli/compare-performance.ts",
    "compose:up": "docker compose --env-file .env -f infra/compose/docker-compose.yml up --build",
    "compose:down": "docker compose --env-file .env -f infra/compose/docker-compose.yml down -v"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "cross-env": "10.1.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current"
      ],
      "cpu": [
        "current",
        "x64",
        "arm64"
      ]
    },
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "proxy-addr@<2.0.8": "2.0.8",
      "@peculiar/asn1-schema": "2.11.0",
      "dompurify@<3.4.17": "3.4.17",
      "ws@>=8 <8.21.1": "8.22.0",
      "e2b>undici8": "npm:undici@8.12.3",
      "@grpc/grpc-js@<1.14.5": "1.14.5",
      "@xmldom/xmldom@<0.8.15": "0.8.15",
      "@xmldom/xmldom@>=0.9.0 <0.9.12": "0.9.12",
      "axios@<1.20.0": "1.20.0",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
      "compression@<1.8.2": "1.8.2",
      "decode-uri-component@<0.5.1": "0.5.1",
      "follow-redirects@<1.16.2": "1.16.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "markdown-it@<14.3.3": "14.3.3",
      "node-forge@<1.4.1": "1.4.1",
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "ip-address@<10.7.4": "10.7.4",
      "jose@>=6.0.0 <6.2.15": "6.2.15",
      "qs@<6.16.1": "6.16.1"
    },
    "patchedDependencies": {
      "app-builder-lib@26.15.3": "patches/app-builder-lib@26.15.3.patch"
    }
  }
}
